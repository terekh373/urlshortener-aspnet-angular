// In a real project it is better to not commit this file with hardcoded secrets, but for demonstration purposes, we will keep it simple so You can test the project.
{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=UrlShortenerDb;Trusted_Connection=True;"
  },
  "JwtSettings": {
    "Secret": "super-secret-key-that-is-long-enough-32chars",
    "Issuer": "UrlShortenerAPI",
    "Audience": "UrlShortenerClient",
    "ExpiryDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
